---
import { Logout } from "@/components/reviewForm/components/Logout";
import Layout from "../layouts/Layout.astro";
import { SearchApp } from "@/components/searchApp/SearchApp";
---

<Layout title="findr | Encuentra un médico de confianza">
	<h1>Encuentra tú médico de confianza</h1>
	<p>Landing Page</p>

	<a
		href="/search"
		class="bg-[#ffffff] w-full min-w-[250px] xs:w-[150px] max-w-[350px] h-[60px] px-3 py-3 rounded-full flex flex-col items-center justify-center m-1 shadow-[0_0_10px_rgba(0,0,0,0.2)]"
	>
		<div class="flex flex-row items-center justify-start relative w-full">
			<svg
				class="absolute left-3"
				width="20"
				height="20"
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 512 512"
			>
				<path
					fill="#2d2d2d"
					d="M416 208c0 45.9-14.9 88.3-40 122.7l126.6 126.7c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.1-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0s208 93.1 208 208M208 352a144 144 0 1 0 0-288a144 144 0 1 0 0 288"
				></path>
			</svg>
			<p class="text-black text-sm text-center w-full">
				Médico, enfermedad o especialidad
			</p>
		</div>
	</a>


</Layout>

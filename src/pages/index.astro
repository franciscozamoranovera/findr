---
import Layout from "../layouts/Layout.astro";
import { NavBar } from "@/components/navbar/NavBar";
import { IndexSearchBar } from "@/components/searchBar/IndexSearchBar";
---

<Layout
    title="findr — Buscar médico en Chile | Reseñas de pacientes reales"
    description="Encuentra tu próximo médico de confianza en Chile. Busca por especialidad, patología o nombre y lee reseñas reales de pacientes."
>
	<div class="flex flex-col h-dvh">
		<NavBar />
		<div class="flex flex-col items-center justify-center flex-1">

			<p class="rounded-lg font-semibold px-[4px] py-[2px] text-[12px] text-[#0066FF] bg-[#afcfff] border border-[#0066FF]">Disponible Red Salud Quilicura</p>

			<h1 class="text-5xl font-normal text-center pt-4 pb-10">Encuentra tu próximo médico de confianza</h1>

			<div class="w-full h-[97px] flex items-center justify-center px-4">
			<IndexSearchBar client:only="react" />
		</div>

			<div class="overflow-hidden w-full pt-10">
				<div class="marquee-track flex gap-3 w-max pb-4">
					<!-- items originales -->
					<a href="/search?SDDsearch=Cardiología&healthcareCenter=Centro+Médico+y+Dental+RedSalud+Quilicura" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Cardiólogo en Red Salud Quilicura</a>
					<a href="/search?SDDsearch=Ginecología+y+Obstetricia&region=Región+Metropolitana&comuna=Quilicura" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Ginecólogos en Red Salud Quilicura</a>
					<a href="/search?SDDsearch=Neurología&region=Región+Metropolitana&comuna=Quilicura" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Neurólogos en Red Salud Quilicura</a>
					<a href="/search?region=Región+Metropolitana&comuna=Quilicura&healthcareCenter=Centro+Médico+y+Dental+RedSalud+Quilicura" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Médico general en Red Salud Quilicura</a>
					<!-- duplicados para loop continuo -->
					<a href="/search?SDDsearch=Cardiología&healthcareCenter=Centro+Médico+y+Dental+RedSalud+Quilicura" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Cardiólogo en Red Salud Quilicura</a>
					<a href="/search?SDDsearch=Ginecología+y+Obstetricia&region=Región+Metropolitana&comuna=Quilicura" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Ginecólogos en Red Salud Quilicura</a>
					<a href="/search?SDDsearch=Neurología&region=Región+Metropolitana&comuna=Quilicura" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Neurólogos en Red Salud Quilicura</a>
					<a href="/search?region=Región+Metropolitana&comuna=Quilicura&healthcareCenter=Centro+Médico+y+Dental+RedSalud+Quilicura" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Médico general en Red Salud Quilicura</a>
				</div>
				<div class="marquee-track-reverse flex gap-3 w-max">
					<!-- items originales -->
					<a href="/search?SDDsearch=Arritmia" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Especialista en Arritmias</a>
					<a href="/search?SDDsearch=Palpitaciones" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Especialista en Palpitaciones</a>
					<a href="/search?SDDsearch=Arritmia" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Especialista en Arritmias</a>
					<a href="/search?SDDsearch=Palpitaciones" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Especialista en Palpitaciones</a>
					<!-- duplicados para loop continuo -->
					<a href="/search?SDDsearch=Arritmia" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Especialista en Arritmias</a>
					<a href="/search?SDDsearch=Palpitaciones" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Especialista en Palpitaciones</a>
					<a href="/search?SDDsearch=Arritmia" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Especialista en Arritmias</a>
					<a href="/search?SDDsearch=Palpitaciones" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Especialista en Palpitaciones</a>
				</div>
			</div>
		</div>

	</div>

	{/* ------------------- Doctor Rating Banner ------------------- */}
	<section class="flex flex-col items-center justify-center py-20 px-4">
		<h2 class="text-3xl font-normal text-center mb-2">Calificaciones reales de pacientes reales</h2>

		<div class="w-full max-w-3xl">
			{/* Doctor Summary Info */}
			<div class="text-center pt-4 pb-2">
				<p class="text-3xl pb-2">👨🏻‍⚕️</p>
				<h1 class="text-black text-3xl pb-1">Dr. Ricardo Martínez Soto</h1>
				<h2 class="text-black font-light text-md">Medicina Interna</h2>
				<h3 class="text-black pt-1 text-xl font-medium">Cardiología</h3>
			</div>

			<div class="grid grid-cols-[1fr_135px_1fr] mb-[25px] mt-[25px]">
				<div class="flex justify-end">
					<img
						class="h-[150px] drop-shadow-[0_4px_8px_rgba(0,0,0,0.3)]"
						src="/img/doctor-profile/left-laurel-findr-it-rating.png"
					/>
				</div>
				<div class="flex items-center justify-center">
					<h1 class="text-8xl">4.7</h1>
				</div>
				<div class="flex justify-start">
					<img
						class="h-[150px] drop-shadow-[0_4px_8px_rgba(0,0,0,0.3)]"
						src="/img/doctor-profile/right-laurel-findr-it-rating.png"
					/>
				</div>
			</div>

			<div class="flex flex-col justify-center items-center gap-2 text-center">
				<p class="text-xl w-2/3">Favorito entre Cardiólogos en la Región Metropolitana</p>
				<p class="text-xl w-2/3"><strong>Dr. Martínez</strong> está dentro del 20% de los cardiólogos mejor valorados en <strong>Red Salud Quilicura</strong></p>
			</div>

			{/* Calification by Category */}
			<div class="gap-5 flex flex-row flex-wrap justify-center items-center mt-16 mb-12">

				<div>
					<div class="w-10">
						<img class="w-8 h-8 object-contain" src="/img/doctor-profile/calification-icons/problem-solved.png" />
					</div>
					<div class="pt-2"><p>Continuaría Atendiendose</p></div>
					<div>
						<div class="relative rounded border-2 border-black w-[200px] h-[9px] bg-white overflow-hidden">
							<div class="absolute left-0 top-0 bottom-0 bg-black" style="width: 96%"></div>
						</div>
					</div>
					<div><h2 class="text-center text-3xl">4.8</h2></div>
				</div>

				<div>
					<div class="w-10">
						<img class="w-8 h-8 object-contain" src="/img/doctor-profile/calification-icons/comunication.png" />
					</div>
					<div class="pt-2"><p>Comunicación Clara</p></div>
					<div>
						<div class="relative rounded border-2 border-black w-[200px] h-[9px] bg-white overflow-hidden">
							<div class="absolute left-0 top-0 bottom-0 bg-black" style="width: 92%"></div>
						</div>
					</div>
					<div><h2 class="text-center text-3xl">4.6</h2></div>
				</div>

				<div>
					<div class="w-10">
						<img class="w-8 h-8 object-contain" src="/img/doctor-profile/calification-icons/attention-profesionalism.png" />
					</div>
					<div class="pt-2"><p>Atención y Ptofesionalismo</p></div>
					<div>
						<div class="relative rounded border-2 border-black w-[200px] h-[9px] bg-white overflow-hidden">
							<div class="absolute left-0 top-0 bottom-0 bg-black" style="width: 100%"></div>
						</div>
					</div>
					<div><h2 class="text-center text-3xl">5.0</h2></div>
				</div>

				<div>
					<div class="w-10">
						<img class="w-8 h-8 object-contain" src="/img/doctor-profile/calification-icons/knoledge-domain.png" />
					</div>
					<div class="pt-2"><p>Dominio Conocimientos</p></div>
					<div>
						<div class="relative rounded border-2 border-black w-[200px] h-[9px] bg-white overflow-hidden">
							<div class="absolute left-0 top-0 bottom-0 bg-black" style="width: 94%"></div>
						</div>
					</div>
					<div><h2 class="text-center text-3xl">4.7</h2></div>
				</div>

				<div>
					<div class="w-10">
						<img class="w-8 h-8 object-contain" src="/img/doctor-profile/calification-icons/recomendation.png" />
					</div>
					<div class="pt-2"><p>Recomendaría a Familiar</p></div>
					<div>
						<div class="relative rounded border-2 border-black w-[200px] h-[9px] bg-white overflow-hidden">
							<div class="absolute left-0 top-0 bottom-0 bg-black" style="width: 88%"></div>
						</div>
					</div>
					<div><h2 class="text-center text-3xl">4.4</h2></div>
				</div>

			</div>
		</div>
	</section>
</Layout>

<style>
	@keyframes marquee {
		0%   { transform: translateX(0%); }
		100% { transform: translateX(-50%); }
	}
	.marquee-track {
		animation: marquee 25s linear infinite;
	}
	.marquee-track a {
		font-family: "Open Sans", sans-serif;
	}
	.marquee-track:hover {
		animation-play-state: paused;
	}
	@keyframes marquee-reverse {
		0%   { transform: translateX(-50%); }
		100% { transform: translateX(0%); }
	}
	.marquee-track-reverse {
		animation: marquee-reverse 10s linear infinite;
	}
	.marquee-track-reverse a {
		font-family: "Open Sans", sans-serif;
	}
	.marquee-track-reverse:hover {
		animation-play-state: paused;
	}
</style>

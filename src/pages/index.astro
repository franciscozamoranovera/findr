---
import Layout from "../layouts/Layout.astro";
import { NavBar } from "@/components/navbar/NavBar";
import { IndexSearchBar } from "@/components/searchBar/IndexSearchBar";
---

<Layout title="findr | Encuentra un médico de confianza">
	<div class="flex flex-col h-dvh">
		<NavBar />
		<div class="flex flex-col items-center justify-center flex-1">

			<p class="rounded-lg font-semibold px-[4px] py-[2px] text-[12px] text-[#0066FF] bg-[#afcfff] border border-[#0066FF]">Disponible Red Salud Quilicura</p>

			<h1 class="text-5xl font-normal text-center pt-4 pb-10">Encuentra tu próximo médico de confianza</h1>

			<div class="w-full h-[97px] flex items-center justify-center px-4">
			<IndexSearchBar client:only="react" />
		</div>

			<div class="overflow-hidden w-full pt-10">
				<div class="marquee-track flex gap-3 w-max pb-4">
					<!-- items originales -->
					<a href="/search?SDDsearch=Cardiología&healthcareCenter=Centro+Médico+y+Dental+RedSalud+Quilicura" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Cardiólogo en Red Salud Quilicura</a>
					<a href="/search?SDDsearch=Ginecología+y+Obstetricia&region=Región+Metropolitana&comuna=Quilicura" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Ginecólogos en Red Salud Quilicura</a>
					<a href="/search?SDDsearch=Neurología&region=Región+Metropolitana&comuna=Quilicura" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Neurólogos en Red Salud Quilicura</a>
					<a href="/search?region=Región+Metropolitana&comuna=Quilicura&healthcareCenter=Centro+Médico+y+Dental+RedSalud+Quilicura" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Médico general en Red Salud Quilicura</a>
					<!-- duplicados para loop continuo -->
					<a href="/search?SDDsearch=Cardiología&healthcareCenter=Centro+Médico+y+Dental+RedSalud+Quilicura" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Cardiólogo en Red Salud Quilicura</a>
					<a href="/search?SDDsearch=Ginecología+y+Obstetricia&region=Región+Metropolitana&comuna=Quilicura" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Ginecólogos en Red Salud Quilicura</a>
					<a href="/search?SDDsearch=Neurología&region=Región+Metropolitana&comuna=Quilicura" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Neurólogos en Red Salud Quilicura</a>
					<a href="/search?region=Región+Metropolitana&comuna=Quilicura&healthcareCenter=Centro+Médico+y+Dental+RedSalud+Quilicura" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Médico general en Red Salud Quilicura</a>
				</div>
				<div class="marquee-track-reverse flex gap-3 w-max">
					<!-- items originales -->
					<a href="/search?SDDsearch=Arritmia" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Especialista en Arritmias</a>
					<a href="/search?SDDsearch=Palpitaciones" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Especialista en Palpitaciones</a>
					<a href="/search?SDDsearch=Arritmia" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Especialista en Arritmias</a>
					<a href="/search?SDDsearch=Palpitaciones" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Especialista en Palpitaciones</a>
					<!-- duplicados para loop continuo -->
					<a href="/search?SDDsearch=Arritmia" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Especialista en Arritmias</a>
					<a href="/search?SDDsearch=Palpitaciones" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Especialista en Palpitaciones</a>
					<a href="/search?SDDsearch=Arritmia" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Especialista en Arritmias</a>
					<a href="/search?SDDsearch=Palpitaciones" class="whitespace-nowrap bg-white text-[#2D2D2D] rounded-full px-4 py-2 text-md font-light hover:bg-[#0066FF] hover:text-white transition-colors duration-200">Especialista en Palpitaciones</a>
				</div>
			</div>
		</div>

	</div>
</Layout>

<style>
	@keyframes marquee {
		0%   { transform: translateX(0%); }
		100% { transform: translateX(-50%); }
	}
	.marquee-track {
		animation: marquee 25s linear infinite;
	}
	.marquee-track a {
		font-family: "Open Sans", sans-serif;
	}
	.marquee-track:hover {
		animation-play-state: paused;
	}
	@keyframes marquee-reverse {
		0%   { transform: translateX(-50%); }
		100% { transform: translateX(0%); }
	}
	.marquee-track-reverse {
		animation: marquee-reverse 10s linear infinite;
	}
	.marquee-track-reverse a {
		font-family: "Open Sans", sans-serif;
	}
	.marquee-track-reverse:hover {
		animation-play-state: paused;
	}
</style>

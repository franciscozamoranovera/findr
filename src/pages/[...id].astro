---
import Layout from "../layouts/Layout.astro";
import { SearchApp } from "../components/searchApp/SearchApp.jsx";
import { string } from "astro:schema";

// Check if this is a UUID-like pattern (doctor ID), basically a regex.
const { id } = Astro.params;
const isUUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id as string);

// If it's a UUID, redirect to the proper /doctor/:id format
if (isUUID) {
  return Astro.redirect(`/doctor/${id}`);
}

// For non-UUID paths, let it pass through to potential 404
---

<Layout title="findr.it">
    <h1>Page not found</h1>
</Layout>